+    if(status || processed!=count){heap_caps_free(rows);reply("ERR bank_run %u %u %u\n",status,completed,processed);return true;}
+    uint32_t crc=esp_rom_crc32_le(0,(void *)rows,count*sizeof(bank_row_t));
+    reply("BANKRUN %u 8188 %08lx %" PRIu64 " %" PRIu64 " %u %u %u\n",count,(unsigned long)crc,start,end,max_work,idle.observed,idle.fallbacks);
+    burst_serial_send(rows,count*sizeof(bank_row_t));heap_caps_free(rows);reply("BANKEND\n");return true;
