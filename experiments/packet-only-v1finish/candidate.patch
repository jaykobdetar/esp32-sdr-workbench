+/* Experimental packet-only admission/accounting; no hardware access.
+ * All times ns; actual triggers must be reported separately from planned slots.
+ * Not a continuous sampling guarantee. Caller must serialize capture/decode. */
+#ifndef SLOT_AUDIT_H
+#define SLOT_AUDIT_H
+#include <stdint.h>
+#include <stdbool.h>
+#define PKTSLOT_MAX 128u
+#define PKTSLOT_APERTURE_NS UINT64_C(1023750)
+typedef struct {
+ uint64_t start_ns, period_ns, last_trigger_ns, gap_ns, max_gap_ns;
+ uint32_t total, next, admitted, skipped, completed, cancelled, capture_faults;
+ bool active, have_trigger, closed;
+} pkt_slot_audit;
+enum { PKTSLOT_INVALID=-1, PKTSLOT_WAIT=0, PKTSLOT_READY=1, PKTSLOT_DONE=2 };
+static inline bool pkt_slot_init(pkt_slot_audit *s,uint64_t start,uint64_t period,uint32_t count) {
+ if(!s || !count || count>PKTSLOT_MAX || period<UINT64_C(10000000) || period>UINT64_C(100000000) || start>UINT64_MAX-period*count)return false;
+ *s=(pkt_slot_audit){.start_ns=start,.period_ns=period,.total=count};return true;
+}
+/* No catch-up captures: reject overdue slots by >50us; count them explicitly.
+ * READY reserves exactly one slot until completion is reported. */
+static inline int pkt_slot_poll(pkt_slot_audit *s,uint64_t now,uint32_t *index,uint64_t *target) {
+ if(!s || !index || !target || s->active || s->closed)return PKTSLOT_INVALID;
+ while(s->next<s->total) {
+  uint64_t t=s->start_ns+(uint64_t)s->next*s->period_ns;
+  if(now<t){*target=t;return PKTSLOT_WAIT;}
+  if(now-t>UINT64_C(50000)){s->next++;s->skipped++;continue;}
+  *target=t;*index=s->next++;s->admitted++;s->active=true;return PKTSLOT_READY;
+ }
+ return PKTSLOT_DONE;
+}
+static inline bool pkt_slot_complete(pkt_slot_audit *s,bool valid,uint64_t actual_trigger) {
+ if(!s || !s->active || s->closed)return false;
+ if(valid && s->have_trigger && actual_trigger<s->last_trigger_ns)return false;
+ s->active=false;
+ if(!valid){s->capture_faults++;return true;}
+ if(s->have_trigger) {
+  uint64_t delta=actual_trigger-s->last_trigger_ns;
+  uint64_t gap=delta>PKTSLOT_APERTURE_NS?delta-PKTSLOT_APERTURE_NS:0;
+  s->gap_ns+=gap;if(gap>s->max_gap_ns)s->max_gap_ns=gap;
+ }
+ s->last_trigger_ns=actual_trigger;s->have_trigger=true;s->completed++;return true;
+}
+static inline bool pkt_slot_close(pkt_slot_audit *s) {
+ if(!s || s->active || s->closed)return false;
+ s->cancelled=s->total-s->next;s->closed=true;
+ return s->total==s->completed+s->capture_faults+s->skipped+s->cancelled;
+}
+#endif
