+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+/* Counter-based, reproducible 32-bit generator. Both odd multipliers and XOR
+ * shifts are bijective; zero is a valid seed. Not cryptographic randomness. */
+static inline uint32_t pipeline_keep_random(uint32_t *state) {
+    uint32_t z = (*state += UINT32_C(0x9e3779b9));
+    z = (z ^ (z >> 16)) * UINT32_C(0x21f0aaad);
+    z = (z ^ (z >> 15)) * UINT32_C(0x735a2d97);
+    return z ^ (z >> 15);
+}
+/* Algorithm R: select candidate N with probability 1/N. Rejection removes
+ * modulo bias; no random draw for the first candidate. No extra IQ buffer. */
+static inline bool pipeline_keep_reservoir(uint32_t *state, uint32_t count) {
+    if (!count) return false;
+    if (count == 1) return true;
+    uint32_t threshold = (uint32_t)(0u - count) % count;
+    uint32_t draw;
+    do { draw = pipeline_keep_random(state); } while (draw < threshold);
+    return draw % count == 0;
+}
