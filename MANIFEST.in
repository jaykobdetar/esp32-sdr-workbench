# Defense in depth for setuptools' automatic inclusions and future additions.
global-exclude *.py[cod] *.sigmf-data *.sigmf-meta *.bin *.elf *.hex *.uf2 *.map
global-exclude .env .env.*
prune records
prune recovery
prune backups
prune nrf52840-transmitter/vendor
prune nrf52840-transmitter/artifacts
prune nrf52840-transmitter/backups
